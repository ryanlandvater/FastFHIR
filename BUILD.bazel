load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")

package(default_visibility = ["//visibility:public"])

# =====================================================================
# Core FastFHIR Library
# =====================================================================
cc_library(
    name = "fastfhir",
    srcs = glob(
        [
            "src/*.cpp",
            "generated_src/*.cpp",
        ],
        exclude = [
            "src/FF_Ingestor.cpp",
            "src/FF_Extensions.cpp",          # Excluded unless WAMR is configured
            "generated_src/FF_IngestMappings.cpp", # Belongs to ingestor
        ],
    ),
    hdrs = glob([
        "include/*.hpp",
        "generated_src/*.hpp",
    ]),
    copts = ["-std=c++20"],
    includes = [
        "generated_src",
        "include",
    ],
)

# =====================================================================
# Ingestor Module
# =====================================================================
cc_library(
    name = "fastfhir_ingestor",
    srcs = [
        "generated_src/FF_IngestMappings.cpp",
        "src/FF_Ingestor.cpp",
    ],
    copts = ["-std=c++20"],
    deps = [
        ":fastfhir",
        "@simdjson//:simdjson",
    ],
)

# =====================================================================
# Command Line Interface Tools
# =====================================================================
cc_binary(
    name = "ff_export",
    srcs = ["tools/exporter/FF_Export.cpp"],
    copts = ["-std=c++20"],
    deps = [":fastfhir"],
)

cc_binary(
    name = "ff_ingest",
    srcs = ["tools/ingestor/ff_ingest.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":fastfhir_ingestor",
        "@boringssl//:crypto",
    ],
)

cc_binary(
    name = "ff_compact",
    srcs = ["tools/compactor/FF_Compact.cpp"],
    copts = ["-std=c++20"],
    defines = ["FASTFHIR_HAS_OPENSSL"],
    deps = [
        ":fastfhir",
        "@boringssl//:crypto",
    ],
)

# =====================================================================
# Python Bindings
# =====================================================================
pybind_extension(
    name = "_core",
    srcs = ["python/FF_PythonBindings.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":fastfhir_ingestor",
        "@boringssl//:crypto",
        "@simdjson//:simdjson",
    ],
)

# =====================================================================
# Tests
# =====================================================================
cc_test(
    name = "test_readme",
    srcs = ["tests/cpp/test_readme.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":fastfhir_ingestor",
        "@asio//:asio",
        "@boringssl//:crypto",
    ],
)
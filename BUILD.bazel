load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")

package(default_visibility = ["//visibility:public"])

# Bazel's MSVC wrapper doesn't translate -std=c++20 → /std:c++20, so pass both.
_COPTS = ["-std=c++20"] + select({
    "@bazel_tools//src/conditions:windows": ["/std:c++20"],
    "//conditions:default": [],
})

# ── Core library ───────────────────────────────────────────────────
cc_library(
    name = "fastfhir",
    srcs = glob(
        ["src/*.cpp", "generated_src/*.cpp"],
        exclude = [
            "src/FF_Ingestor.cpp",
            "src/FF_Extensions.cpp",
            "generated_src/FF_IngestMappings.cpp",
        ],
    ),
    hdrs = glob(["include/*.hpp", "generated_src/*.hpp"]),
    copts = _COPTS,
    includes = ["generated_src", "include"],
)

# ── Ingestor ───────────────────────────────────────────────────────
cc_library(
    name = "fastfhir_ingestor",
    srcs = [
        "generated_src/FF_IngestMappings.cpp",
        "src/FF_Ingestor.cpp",
    ],
    copts = _COPTS,
    deps = [":fastfhir", "@simdjson//:simdjson"],
)

# ── CLI tools ──────────────────────────────────────────────────────
cc_binary(
    name = "ff_export",
    srcs = ["tools/exporter/FF_Export.cpp"],
    copts = _COPTS,
    deps = [":fastfhir"],
)

cc_binary(
    name = "ff_ingest",
    srcs = ["tools/ingestor/FF_Ingest.cpp"],
    copts = _COPTS,
    deps = [":fastfhir_ingestor", "@boringssl//:crypto"],
)

cc_binary(
    name = "ff_compact",
    srcs = ["tools/compactor/FF_Compact.cpp"],
    copts = _COPTS,
    defines = ["FASTFHIR_HAS_OPENSSL"],
    deps = [":fastfhir", "@boringssl//:crypto"],
)

# ── Python bindings ────────────────────────────────────────────────
pybind_extension(
    name = "_core",
    srcs = ["python/FF_PythonBindings.cpp"],
    copts = _COPTS,
    deps = [":fastfhir_ingestor", "@boringssl//:crypto", "@simdjson//:simdjson"],
)

# ── Tests ──────────────────────────────────────────────────────────
cc_test(
    name = "test_readme",
    srcs = ["tests/cpp/test_readme.cpp"],
    copts = _COPTS,
    deps = [":fastfhir_ingestor", "@asio//:asio", "@boringssl//:crypto"],
)

cc_test(
    name = "test_primitives",
    srcs = ["tests/cpp/test_primitives.cpp"],
    copts = _COPTS,
    deps = [":fastfhir"],
)

cc_test(
    name = "test_memory",
    srcs = ["tests/cpp/test_memory.cpp"],
    copts = _COPTS,
    deps = [":fastfhir"],
)

cc_test(
    name = "test_simd",
    srcs = ["tests/cpp/test_simd.cpp"],
    copts = _COPTS,
    deps = [":fastfhir"],
)
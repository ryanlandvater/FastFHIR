load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("//:tests/tests.bzl", "fastfhir_tests")

package(default_visibility = ["//visibility:public"])

# Bazel's MSVC wrapper doesn't translate -std=c++20 → /std:c++20, so pass both.
_COPTS = ["-std=c++20"] + select({
    "@bazel_tools//src/conditions:windows": ["/std:c++20"],
    "//conditions:default": [],
})

# ── Core library ───────────────────────────────────────────────────
cc_library(
    name = "fastfhir",
    srcs = glob(
        ["src/*.cpp", "generated_src/*.cpp"],
        exclude = [
            "src/FF_Ingestor.cpp",
            "src/FF_Extensions.cpp",
            "generated_src/FF_IngestMappings.cpp",
        ],
    ),
    hdrs = glob(["include/*.hpp", "generated_src/*.hpp"]),
    copts = _COPTS,
    includes = ["generated_src", "include"],
)

# ── Ingestor ───────────────────────────────────────────────────────
cc_library(
    name = "fastfhir_ingestor",
    srcs = [
        "generated_src/FF_IngestMappings.cpp",
        "src/FF_Ingestor.cpp",
    ],
    copts = _COPTS,
    deps = [":fastfhir", "@simdjson//:simdjson"],
)

# ── CLI tools ──────────────────────────────────────────────────────
cc_binary(
    name = "ff_export",
    srcs = ["tools/exporter/FF_Export.cpp"],
    copts = _COPTS,
    deps = [":fastfhir"],
)

cc_binary(
    name = "ff_ingest",
    srcs = ["tools/ingestor/FF_Ingest.cpp"],
    copts = _COPTS,
    deps = [":fastfhir_ingestor", "@boringssl//:crypto"],
)

cc_binary(
    name = "ff_compact",
    srcs = ["tools/compactor/FF_Compact.cpp"],
    copts = _COPTS,
    # The engine version must match CMakeLists.txt and FF_Version.hpp exactly.
    # Leaving it to the header fallback is what let Bazel compile 2026.1 while
    # CMake compiled 2026.0, which made the same recover() call disagree about
    # what is a hole and what is version skew.
    defines = [
        "FASTFHIR_HAS_OPENSSL",
        "FASTFHIR_VERSION_MAJOR=2026",
        "FASTFHIR_VERSION_MINOR=0",
        "FASTFHIR_VERSION_BUILD=0",
    ],
    deps = [":fastfhir", "@boringssl//:crypto"],
)

# ── Python bindings ────────────────────────────────────────────────
pybind_extension(
    name = "_core",
    srcs = ["python/FF_PythonBindings.cpp"],
    copts = _COPTS,
    deps = [":fastfhir_ingestor", "@boringssl//:crypto", "@simdjson//:simdjson"],
)

# ── Tests ──────────────────────────────────────────────────────────
# All test definitions (C++ unit suites, README suite, round-trip harness)
# live in tests/tests.bzl so this file stays a readable build definition.
fastfhir_tests(copts = _COPTS)
